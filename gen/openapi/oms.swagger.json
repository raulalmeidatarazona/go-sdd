{
  "swagger": "2.0",
  "info": {
    "title": "OMS Order API",
    "description": "REST facade transcoded from the gRPC OrderService. Every request must carry the X-Tenant-Id header.",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "OrderService",
      "description": "OrderService is the public contract of the ordering bounded context.\nCommands (Place, Cancel) return identifiers only; read through queries."
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/orders": {
      "get": {
        "summary": "Lists orders newest first using opaque cursor pagination.",
        "operationId": "OrderService_ListOrders",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListOrdersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pageSize",
            "description": "Defaults to 50, maximum 200.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "description": "Optional filters.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ORDER_STATUS_UNSPECIFIED",
              "ORDER_STATUS_PLACED",
              "ORDER_STATUS_CANCELLED"
            ],
            "default": "ORDER_STATUS_UNSPECIFIED"
          },
          {
            "name": "customerId",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "OrderService"
        ]
      },
      "post": {
        "summary": "Places a new order. Idempotent per (tenant, idempotency_key).",
        "operationId": "OrderService_PlaceOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PlaceOrderResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1PlaceOrderRequest"
            }
          }
        ],
        "tags": [
          "OrderService"
        ]
      }
    },
    "/v1/orders/{orderId}": {
      "get": {
        "summary": "Returns one order from the read model.",
        "operationId": "OrderService_GetOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetOrderResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "OrderService"
        ]
      }
    },
    "/v1/orders/{orderId}:cancel": {
      "post": {
        "summary": "Cancels a placed order.",
        "operationId": "OrderService_CancelOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CancelOrderResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OrderServiceCancelOrderBody"
            }
          }
        ],
        "tags": [
          "OrderService"
        ]
      }
    }
  },
  "definitions": {
    "OrderServiceCancelOrderBody": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ]
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1CancelOrderResponse": {
      "type": "object"
    },
    "v1GetOrderResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/v1Order"
        }
      }
    },
    "v1LineItem": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        },
        "unitPriceMinor": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "A purchased item. Prices are integers in the currency's minor unit (cents)\nto avoid floating point rounding.",
      "required": [
        "sku",
        "quantity",
        "unitPriceMinor"
      ]
    },
    "v1ListOrdersResponse": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Order"
          }
        },
        "nextPageToken": {
          "type": "string",
          "description": "Empty when there are no more pages."
        }
      }
    },
    "v1Order": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "readOnly": true
        },
        "customerId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1OrderStatus"
        },
        "currencyCode": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1LineItem"
          }
        },
        "totalMinor": {
          "type": "string",
          "format": "int64"
        },
        "cancellationReason": {
          "type": "string"
        },
        "placedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "format": "int64",
          "description": "Aggregate version the view reflects. Increases on every state change."
        }
      },
      "description": "Read model of an order. Served from the query side, so it is eventually\nconsistent with commands (typically a few milliseconds behind)."
    },
    "v1OrderStatus": {
      "type": "string",
      "enum": [
        "ORDER_STATUS_UNSPECIFIED",
        "ORDER_STATUS_PLACED",
        "ORDER_STATUS_CANCELLED"
      ],
      "default": "ORDER_STATUS_UNSPECIFIED",
      "description": "Lifecycle of an order. Values map 1:1 to domain.Status."
    },
    "v1PlaceOrderRequest": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "description": "Client-generated key. Retrying with the same key and payload returns the\noriginal order; the same key with a different payload fails with ALREADY_EXISTS."
        },
        "customerId": {
          "type": "string"
        },
        "currencyCode": {
          "type": "string",
          "description": "ISO 4217 code, e.g. EUR."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1LineItem"
          }
        }
      },
      "required": [
        "idempotencyKey",
        "customerId",
        "currencyCode",
        "lines"
      ]
    },
    "v1PlaceOrderResponse": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        }
      }
    }
  }
}
